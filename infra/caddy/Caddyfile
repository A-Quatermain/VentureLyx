# Venturelyx :: internal reverse proxy.
# TLS terminates at Cloudflare; cloudflared connects to this on :8080.
# Nothing here is exposed to the LAN.

{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	log {
		output stdout
		format console
	}

	@api host api.venturelyx.com
	handle @api {
		reverse_proxy api:3000
	}

	@app host app.venturelyx.com
	handle @app {
		reverse_proxy web:3000
	}

	# Apex and www both serve the marketing site — web/src/app/(marketing)/page.tsx
	# handles both the public landing page and (for a signed-in visitor) the
	# redirect into the app, so this just proxies straight through rather
	# than redirecting to app.venturelyx.com.
	@root host venturelyx.com www.venturelyx.com
	handle @root {
		reverse_proxy web:3000
	}

	# Anything else reaching the tunnel gets a flat refusal rather than a
	# confusing default page.
	handle {
		respond "Not found" 404
	}
}
