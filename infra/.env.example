# =============================================================================
# Venturelyx :: environment
#
# Copy to /opt/venturelyx/infra/.env and fill in with `nano`. Never commit.
#
# *** CRITICAL: POSTGRES_PASSWORD IS SET ONCE, AT FIRST INIT, AND NEVER   ***
# *** ROTATED. Postgres bakes the password into the data directory during ***
# *** initdb. Changing it in .env afterwards will NOT change the database  ***
# *** and the stack will fail to connect. Same lesson as CampusPath.       ***
#
# Generate every secret with:
#   openssl rand -hex 32
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=venturelyx
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_DB=venturelyx

# Application role created by migration 001. Distinct from the superuser above.
# This is the role the API connects as; RLS is FORCEd against it.
APP_DB_USER=venturelyx_app
APP_DB_PASSWORD=GENERATE_ME

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_ME

# --- MinIO --------------------------------------------------------------------
MINIO_ROOT_USER=venturelyx
MINIO_ROOT_PASSWORD=GENERATE_ME
MINIO_CONSOLE_URL=http://192.168.1.158:9001

# --- Application crypto -------------------------------------------------------
# AES-256-GCM key for the credential vault (integrations.credential_enc).
# 64 hex chars = 32 bytes. Losing this makes every stored OAuth token
# unrecoverable — back it up separately from the database.
VAULT_KEY=GENERATE_ME

# Session token signing
SESSION_SECRET=GENERATE_ME

# --- Google Search Console (routes/integrations.ts) ---------------------------
# OAuth client from console.cloud.google.com. Authorized redirect URI must be
# exactly https://api.venturelyx.com/v1/integrations/gsc/oauth/callback.
# Scope requested: https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Deployment ---------------------------------------------------------------
TZ=UTC
BACKUP_RETENTION_DAYS=14
